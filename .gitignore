# --- System / IDE Junk ---
.DS_Store
Thumbs.db
__pycache__/
*.pyc
*.pyo
*$py.class

# --- Music Files ---
# We keep the folder structure but ignore the actual audio tracks
/Music/*
!/Music/.gitkeep

# --- Recordings ---
# Sibling of Music/, not a subfolder of it — kept out of Mixxx's (recursive)
# library scan of Music/. Same treatment as Music/: /Recordings/* here keeps
# new files ignored, and Recordings/.gitignore (tracked, since a tracked file
# is never hidden by .gitignore rules) is what actually keeps the empty
# folder present in git.
/Recordings/*

# --- Mixxx Generated / Temporary Files ---
/Mixxx_Data/*
/Mixxx_Data/logs/
/Mixxx_Data/covers/
/Mixxx_Data/analysis/
/Mixxx_Data/translations/
/Mixxx_Data/shortcuts/
/Mixxx_Data/broadcast_profiles/
/Mixxx_Data/*.log
/Mixxx_Data/mixxxdb.sqlite-wal
/Mixxx_Data/mixxxdb.sqlite-shm

# --- Mixxx Configs ---
# The active working config is machine-specific and gets recreated by the
# scripts on every launch, so it's never tracked.
/Mixxx_Data/mixxx.cfg

# Mixxx_Data/Configs holds per-machine hardware profiles
# (mixxx.cfg.<hostname>), which are host-specific and never tracked.
# Shared OS-level templates (mixxx.cfg.win / .lin / .mac) CAN be tracked
# if present. /Mixxx_Data/* above ignores the whole Configs/ directory as
# a unit, so it must be explicitly un-ignored before per-file exceptions
# inside it can take effect.
!/Mixxx_Data/Configs/
/Mixxx_Data/Configs/*
!/Mixxx_Data/Configs/mixxx.cfg.win
!/Mixxx_Data/Configs/mixxx.cfg.lin
!/Mixxx_Data/Configs/mixxx.cfg.mac

# NOTE: mixxxdb.sqlite is intentionally NOT un-ignored. It's a live,
# per-user music library (real filenames/artists/play history), and this
# project is cloned by multiple independent users — shipping one user's
# personal database as a tracked "seed" file would leak their data into
# a public repo. mixxx_path_fixer.py already handles a missing database
# by letting Mixxx create a fresh empty one on first launch.

# --- Python Portable (Windows) ---
# Normally Git ignores .exe and .dll, but we NEED these for the portable engine.
# We un-ignore the python_win folder specifically.
!/Scripts/python_win/
/Scripts/python_win/**
!/Scripts/python_win/*.exe
!/Scripts/python_win/*.dll
!/Scripts/python_win/*.pyd
!/Scripts/python_win/*.zip
!/Scripts/python_win/*.pth
!/Scripts/python_win/*._pth
!/Scripts/python_win/*.txt
!/Scripts/python_win/Lib/

# --- Project Files to KEEP ---
# (Git includes these by default, but listed here for clarity)
!start_smart_linux.sh
!start_smart_windows.bat
!start_smart_macos.sh
!/Scripts/mixxx_path_fixer.py